{
  // Static-only Worker: no script, just the rendered Quarto site in docs/.
  // `quarto render` regenerates docs/, which is committed, so deploys are a
  // plain file upload with no build step.
  "name": "jameshodges",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./docs",
    "not_found_handling": "404-page"
  }
}
